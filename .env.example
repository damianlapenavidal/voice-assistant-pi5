# Copy to .env on the Pi and adjust if your USB devices differ.
# List devices: arecord -l  (mic)  and  aplay -l  (speaker)

# USB microphone (card 2 on voice-assistant-pi5)
AUDIO_INPUT_DEVICE=plughw:2,0

# USB speaker — USB Device 0x1908:0x1331 (card 3 on voice-assistant-pi5)
AUDIO_OUTPUT_DEVICE=plughw:3,0

# Mic calibration at session start: quiet period, then speaker says "Say hello to start"
CALIBRATION_QUIET_SEC=1.0
CALIBRATION_SPEAK_SEC=5.0

# Software make-up gain (steady multipliers, soft-limited — not per-chunk AGC)
INPUT_GAIN=1.0
PLAYBACK_GAIN=1.0
